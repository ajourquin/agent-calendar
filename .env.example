# Inject the real values in Trinity → Credentials (never commit them).
# Google Calendar → the dedicated calendar's settings → "Integrate calendar" → Calendar ID
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# The service account's JSON key, base64-encoded on one line (base64 -w0 key.json).
# The service account must be shared on that calendar only, "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_JSON_B64=base64-of-the-service-account-json-key
